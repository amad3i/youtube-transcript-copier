{
  "manifest_version": 3,
  "name": "YouTube Transcript Copier",
  "version": "1.9.5",
  "description": "Copy YouTube video transcripts with one click",
  "permissions": ["activeTab", "offscreen", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
